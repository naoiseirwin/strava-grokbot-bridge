# Get these from https://www.strava.com/settings/api
# Do not paste these values into GrokBot chat. Use a secret-request or write
# them on the cloud computer only.
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# Optional. Default on a GrokBot computer is /workspace/.strava-mcp.env
# STRAVA_MCP_ENV_FILE=/workspace/.strava-mcp.env

# Distance/elevation units: "meters" (default) or "feet"
# STRAVA_MEASUREMENT_PREFERENCE=meters
